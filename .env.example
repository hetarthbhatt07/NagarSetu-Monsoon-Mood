# ==============================================================================
# NAGARSETU (Metro Hacks PS-12) — Environment Configuration Template
# Copy this file to .env.local to customize environment settings.
# ==============================================================================

# Application Details
NEXT_PUBLIC_APP_NAME="NAGARSETU"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Target Operational Metro Center
NEXT_PUBLIC_DEFAULT_CITY="Ahmedabad"
NEXT_PUBLIC_DEFAULT_LAT=23.0225
NEXT_PUBLIC_DEFAULT_LNG=72.5714
NEXT_PUBLIC_DEFAULT_STATION_ID="kalupur"

# Weather & Telemetry APIs
# Open-Meteo does not require an API key for standard non-commercial use
NEXT_PUBLIC_OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"

# Optional External Integrations (Roadmap / Production Deployment)
# NEXT_PUBLIC_MAPBOX_TOKEN=""
# IMD_RADAR_API_KEY=""
# WHATSAPP_BUSINESS_API_TOKEN=""
# OCC_SCADA_WEBHOOK_URL=""
